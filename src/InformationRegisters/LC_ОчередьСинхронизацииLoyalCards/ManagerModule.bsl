////////////////////////////////////////////////////////////////////////////////
// Регістр відомостей LC_ОчередьСинхронизацииLoyalCards — модуль менеджера
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Додає або оновлює запис черги для контрагента.
//
Процедура ДобавитьВОчередь(Контрагент, ДоступныйБаланс) Экспорт
	
	Если Не ЗначениеЗаполнено(Контрагент) Тогда
		Возврат;
	КонецЕсли;
	
	МенеджерЗаписи = СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Контрагент = Контрагент;
	МенеджерЗаписи.ДатаИзменения = ТекущаяДатаСеанса();
	МенеджерЗаписи.ДоступныйБаланс = ДоступныйБаланс;
	МенеджерЗаписи.Синхронизировано = Ложь;
	МенеджерЗаписи.ДатаСинхронизации = '00010101';
	МенеджерЗаписи.ТекстОшибки = "";
	МенеджерЗаписи.Записать();
	
КонецПроцедуры

// Повертає таблицю несинхронізованих контрагентів.
//
Функция ПолучитьНесинхронизированные() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Очередь.Контрагент КАК Контрагент,
	|	Очередь.ДоступныйБаланс КАК ДоступныйБаланс,
	|	Очередь.ДатаИзменения КАК ДатаИзменения,
	|	Очередь.ТекстОшибки КАК ТекстОшибки
	|ИЗ
	|	РегистрСведений.LC_ОчередьСинхронизацииLoyalCards КАК Очередь
	|ГДЕ
	|	НЕ Очередь.Синхронизировано
	|
	|УПОРЯДОЧИТЬ ПО
	|	Очередь.ДатаИзменения";
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

// Позначає запис синхронізованим.
//
Процедура ОтметитьСинхронизированным(Контрагент, ДоступныйБаланс) Экспорт
	
	МенеджерЗаписи = СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Контрагент = Контрагент;
	МенеджерЗаписи.Прочитать();
	
	Если Не МенеджерЗаписи.Выбран() Тогда
		ДобавитьВОчередь(Контрагент, ДоступныйБаланс);
		МенеджерЗаписи.Прочитать();
	КонецЕсли;
	
	МенеджерЗаписи.Синхронизировано = Истина;
	МенеджерЗаписи.ДатаСинхронизации = ТекущаяДатаСеанса();
	МенеджерЗаписи.ДоступныйБаланс = ДоступныйБаланс;
	МенеджерЗаписи.ТекстОшибки = "";
	МенеджерЗаписи.Записать();
	
КонецПроцедуры

// Фіксує помилку синхронізації.
//
Процедура ЗафиксироватьОшибку(Контрагент, ТекстОшибки) Экспорт
	
	МенеджерЗаписи = СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Контрагент = Контрагент;
	МенеджерЗаписи.Прочитать();
	
	Если МенеджерЗаписи.Выбран() Тогда
		МенеджерЗаписи.Синхронизировано = Ложь;
		МенеджерЗаписи.ТекстОшибки = ТекстОшибки;
		МенеджерЗаписи.Записать();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
