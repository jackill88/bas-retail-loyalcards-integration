#Область ПрограммныйИнтерфейс

// Повертає кешований токен, якщо він ще дійсний.
//
Функция ПолучитьТокен() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Токены.Токен КАК Токен
	|ИЗ
	|	РегистрСведений.LC_ТокеныLoyalCards КАК Токены
	|ГДЕ
	|	Токены.ДатаИстечения > &ТекущаяДата";
	
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДатаСеанса());
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Токен;
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

// Зберігає токен у кеш (за замовчуванням на 50 хвилин).
//
Процедура СохранитьТокен(Токен, ВремяЖизниСек = 3000) Экспорт
	
	ОчиститьТокен();
	
	МенеджерЗаписи = СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Токен = Токен;
	МенеджерЗаписи.ДатаИстечения = ТекущаяДатаСеанса() + ВремяЖизниСек;
	МенеджерЗаписи.Записать();
	
КонецПроцедуры

// Видаляє кешований токен (при 401 або logout).
//
Процедура ОчиститьТокен() Экспорт
	
	НаборЗаписей = СоздатьНаборЗаписей();
	НаборЗаписей.Записать();
	
КонецПроцедуры

#КонецОбласти
