////////////////////////////////////////////////////////////////////////////////
// Регістр відомостей LC_ПартииБонусов — модуль менеджера
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Повертає структуру з даними партії.
//
Функция ПолучитьДанныеПартии(ПартияБонусов) Экспорт
	
	Результат = Новый Структура(
		"Контрагент, ДокументОснование, ДатаНачисления, ДатаАктивации, ДатаСгорания, "
		+ "СуммаНачислена, УровеньЛояльности, Активирована, Сгорела");
	
	МенеджерЗаписи = СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ПартияБонусов = ПартияБонусов;
	МенеджерЗаписи.Прочитать();
	
	Если МенеджерЗаписи.Выбран() Тогда
		ЗаполнитьЗначенияСвойств(Результат, МенеджерЗаписи);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Партії, готові до активації на дату.
//
Функция ПолучитьПартииДляАктивации(ДатаОперации) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Партии.ПартияБонусов КАК ПартияБонусов,
	|	Партии.Контрагент КАК Контрагент
	|ИЗ
	|	РегистрСведений.LC_ПартииБонусов КАК Партии
	|ГДЕ
	|	Партии.ДатаАктивации <= &ДатаОперации
	|	И НЕ Партии.Активирована
	|	И НЕ Партии.Сгорела";
	
	Запрос.УстановитьПараметр("ДатаОперации", ДатаОперации);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

// Партії, термін яких закінчився.
//
Функция ПолучитьПартииДляСгорания(ДатаОперации) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Партии.ПартияБонусов КАК ПартияБонусов,
	|	Партии.Контрагент КАК Контрагент
	|ИЗ
	|	РегистрСведений.LC_ПартииБонусов КАК Партии
	|ГДЕ
	|	Партии.ДатаСгорания < &ДатаОперации
	|	И Партии.Активирована
	|	И НЕ Партии.Сгорела";
	
	Запрос.УстановитьПараметр("ДатаОперации", НачалоДня(ДатаОперации));
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

// Оновлює прапорець активації.
//
Процедура УстановитьАктивирована(ПартияБонусов, Значение) Экспорт
	УстановитьПризнак(ПартияБонусов, "Активирована", Значение);
КонецПроцедуры

// Оновлює прапорець згоряння.
//
Процедура УстановитьСгорела(ПартияБонусов, Значение) Экспорт
	УстановитьПризнак(ПартияБонусов, "Сгорела", Значение);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура УстановитьПризнак(ПартияБонусов, ИмяПризнака, Значение)
	
	МенеджерЗаписи = СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ПартияБонусов = ПартияБонусов;
	МенеджерЗаписи.Прочитать();
	
	Если МенеджерЗаписи.Выбран() Тогда
		МенеджерЗаписи[ИмяПризнака] = Значение;
		МенеджерЗаписи.Записать();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
