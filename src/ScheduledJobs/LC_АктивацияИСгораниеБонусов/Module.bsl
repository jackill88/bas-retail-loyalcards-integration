////////////////////////////////////////////////////////////////////////////////
// Регламентне завдання LC_АктивацияИСгораниеБонусов
// Розклад: щодня о 00:00
//
// 1. Активація бонусів (14 днів після нарахування)
// 2. Згоряння прострочених бонусів (4 міс. після активації)
// 3. Синхронізація balance з Loyal Cards API
////////////////////////////////////////////////////////////////////////////////

Процедура ВыполнитьРегламентноеЗадание() Экспорт
	
	ДатаОперации = НачалоДня(ТекущаяДатаСеанса());
	ЗатронутыеКонтрагенты = Новый Массив;
	
	Попытка
		
		// 1. Активація
		КонтрагентыАктивации = LC_БонуснаяПрограммаСервер.ВыполнитьАктивациюПартий(ДатаОперации);
		Для Каждого Контрагент Из КонтрагентыАктивации Цикл
			Если ЗатронутыеКонтрагенты.Найти(Контрагент) = Неопределено Тогда
				ЗатронутыеКонтрагенты.Добавить(Контрагент);
			КонецЕсли;
		КонецЦикла;
		
		// 2. Згоряння
		КонтрагентыСгорания = LC_БонуснаяПрограммаСервер.ВыполнитьСгораниеПартий(ДатаОперации);
		Для Каждого Контрагент Из КонтрагентыСгорания Цикл
			Если ЗатронутыеКонтрагенты.Найти(Контрагент) = Неопределено Тогда
				ЗатронутыеКонтрагенты.Добавить(Контрагент);
			КонецЕсли;
		КонецЦикла;
		
		// 3. Синхронізація balance з API (після всіх рухів)
		LC_СинхронизацияLoyalCards.СинхронизироватьСписокКонтрагентов(ЗатронутыеКонтрагенты);
		
		// 4. Обробка черги несинхронізованих (офлайн-каси, помилки)
		LC_СинхронизацияLoyalCards.ОбработатьОчередьСинхронизации();
		
		LC_ОбщегоНазначения.ЗаписатьВЖурнал(
			УровеньЖурналаРегистрации.Информация,
			"Регламент",
			СтрШаблон("Активація/згоряння виконано. Зачеплено контрагентів: %1", ЗатронутыеКонтрагенты.Количество()));
		
	Исключение
		LC_ОбщегоНазначения.ЗаписатьВЖурнал(
			УровеньЖурналаРегистрации.Ошибка,
			"Регламент",
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры
