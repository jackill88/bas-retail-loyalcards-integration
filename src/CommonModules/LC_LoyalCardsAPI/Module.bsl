#Область ПрограммныйИнтерфейс

// Авторизація та отримання JWT-токена.
//
// Повертає:
//  Рядок - токен (без префікса Bearer) або порожній рядок при помилці.
//
Функция ПолучитьТокен(ПринудительноеОбновление = Ложь) Экспорт
	
	Если Не ПринудительноеОбновление Тогда
		КешированныйТокен = РегистрыСведений.LC_ТокеныLoyalCards.ПолучитьТокен();
		Если ЗначениеЗаполнено(КешированныйТокен) Тогда
			Возврат КешированныйТокен;
		КонецЕсли;
	КонецЕсли;
	
	Настройки = LC_ОбщегоНазначения.ПолучитьНастройкиИнтеграции();
	
	Если Не Настройки.ИспользоватьИнтеграцию Тогда
		Возврат "";
	КонецЕсли;
	
	ТелоЗапроса = Новый Структура("email, password", Настройки.Email, Настройки.Пароль);
	Ответ = ВыполнитьЗапрос("POST", "/api/auth/login", ТелоЗапроса, Ложь);
	
	Если Ответ.КодСостояния <> 200 Тогда
		LC_ОбщегоНазначения.ЗаписатьВЖурнал(
			УровеньЖурналаРегистрации.Ошибка,
			"Auth",
			СтрШаблон("Помилка авторизації Loyal Cards: HTTP %1", Ответ.КодСостояния));
		Возврат "";
	КонецЕсли;
	
	ТокенПолный = Ответ.Данные.Получить("token");
	Если Не ЗначениеЗаполнено(ТокенПолный) Тогда
		Возврат "";
	КонецЕсли;
	
	Токен = СтрЗаменить(ТокенПолный, "Bearer ", "");
	РегистрыСведений.LC_ТокеныLoyalCards.СохранитьТокен(Токен);
	
	Возврат Токен;
	
КонецФункции

// Пошук картки за телефоном.
//
// Повертає:
//  Масив структур Placeholders або порожній масив.
//
Функция НайтиКартыПоТелефону(Телефон) Экспорт
	
	Настройки = LC_ОбщегоНазначения.ПолучитьНастройкиИнтеграции();
	НормТелефон = LC_ОбщегоНазначения.НормализоватьТелефон(Телефон);
	
	Путь = СтрШаблон("/api/v1/passes/%1/values?tel=%2",
		Настройки.PassTypeIdentifier,
		НормТелефон);
	
	Ответ = ВыполнитьЗапрос("GET", Путь);
	
	Если Ответ.КодСостояния = 200 И ТипЗнч(Ответ.Данные) = Тип("Массив") Тогда
		Возврат Ответ.Данные;
	КонецЕсли;
	
	Возврат Новый Массив;
	
КонецФункции

// Пошук картки за номером memberId.
//
Функция НайтиКартыПоMemberId(MemberId) Экспорт
	
	Настройки = LC_ОбщегоНазначения.ПолучитьНастройкиИнтеграции();
	
	Путь = СтрШаблон("/api/v1/passes/%1/values?memberId=%2",
		Настройки.PassTypeIdentifier,
		MemberId);
	
	Ответ = ВыполнитьЗапрос("GET", Путь);
	
	Если Ответ.КодСостояния = 200 И ТипЗнч(Ответ.Данные) = Тип("Массив") Тогда
		Возврат Ответ.Данные;
	КонецЕсли;
	
	Возврат Новый Массив;
	
КонецФункции

// Отримання даних однієї картки за serialNumber.
//
Функция ПолучитьДанныеКарты(SerialNumber) Экспорт
	
	Настройки = LC_ОбщегоНазначения.ПолучитьНастройкиИнтеграции();
	
	Путь = СтрШаблон("/api/v1/passes/%1/%2/values",
		Настройки.PassTypeIdentifier,
		SerialNumber);
	
	Ответ = ВыполнитьЗапрос("GET", Путь);
	
	Если Ответ.КодСостояния = 200 Тогда
		Возврат Ответ.Данные;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

// Створення нової wallet-картки.
//
// Параметри:
//  ДанныеКарты - Структура - firstName, lastName, tel, memberId, balance, discount.
//
// Повертає:
//  Структура - passTypeIdentifier, serialNumber, url або Неопределено.
//
Функция СоздатьКарту(ДанныеКарты) Экспорт
	
	Настройки = LC_ОбщегоНазначения.ПолучитьНастройкиИнтеграции();
	
	Путь = СтрШаблон("/api/v1/passes/%1/pass/memberId",
		Настройки.PassTypeIdentifier);
	
	Ответ = ВыполнитьЗапрос("POST", Путь, ДанныеКарты);
	
	Если Ответ.КодСостояния = 201 Тогда
		Возврат Ответ.Данные;
	КонецЕсли;
	
	LC_ОбщегоНазначения.ЗаписатьВЖурнал(
		УровеньЖурналаРегистрации.Ошибка,
		"CreatePass",
		СтрШаблон("Не вдалося створити картку: HTTP %1", Ответ.КодСостояния));
	
	Возврат Неопределено;
	
КонецФункции

// Оновлення балансу на wallet-картці.
//
Функция ОбновитьБаланс(SerialNumber, Баланс) Экспорт
	Возврат ОбновитьPlaceholder(SerialNumber, "balance", Формат(Баланс, "ЧДЦ=2; ЧРГ=''; ЧГ=0"));
КонецФункции

// Оновлення знижки (рівень лояльності) на wallet-картці.
//
Функция ОбновитьСкидку(SerialNumber, ПроцентСкидки) Экспорт
	Возврат ОбновитьPlaceholder(SerialNumber, "discount", Формат(ПроцентСкидки, "ЧДЦ=0; ЧРГ=''; ЧГ=0"));
КонецФункции

// Оновлення одного placeholder на картці.
//
Функция ОбновитьPlaceholder(SerialNumber, ИмяPlaceholder, Значение) Экспорт
	
	Настройки = LC_ОбщегоНазначения.ПолучитьНастройкиИнтеграции();
	
	Путь = СтрШаблон("/api/v1/passes/%1/%2/values/%3",
		Настройки.PassTypeIdentifier,
		SerialNumber,
		ИмяPlaceholder);
	
	Тело = Новый Структура("value", Значение);
	Ответ = ВыполнитьЗапрос("PUT", Путь, Тело);
	
	Возврат Ответ.КодСостояния = 200;
	
КонецФункции

// Масове оновлення карток (balance, discount тощо).
//
Функция ОбновитьКартыПакетом(МассивДанных) Экспорт
	
	Настройки = LC_ОбщегоНазначения.ПолучитьНастройкиИнтеграции();
	
	Путь = СтрШаблон("/api/v1/passes/%1/passes",
		Настройки.PassTypeIdentifier);
	
	Ответ = ВыполнитьЗапрос("PUT", Путь, МассивДанных);
	
	Возврат Ответ.КодСостояния = 200;
	
КонецФункции

// Деактивація картки.
//
Функция ДеактивироватьКарту(SerialNumber) Экспорт
	
	Настройки = LC_ОбщегоНазначения.ПолучитьНастройкиИнтеграции();
	
	Путь = СтрШаблон("/api/v1/passes/%1/%2/status",
		Настройки.PassTypeIdentifier,
		SerialNumber);
	
	Тело = Новый Структура("status", "inactive");
	Ответ = ВыполнитьЗапрос("PUT", Путь, Тело);
	
	Возврат Ответ.КодСостояния = 200;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ВыполнитьЗапрос(Метод, Путь, Тело = Неопределено, ИспользоватьАвторизацию = Истина)
	
	Настройки = LC_ОбщегоНазначения.ПолучитьНастройкиИнтеграции();
	Результат = Новый Структура("КодСостояния, Данные, Заголовки", 0, Неопределено, Новый Соответствие);
	
	Попытка
		
		Соединение = Новый HTTPСоединение(
			ИзвлечьХост(Настройки.АдресСервера),
			,
			,
			,
			,
			Настройки.ТаймаутСек,
			?(СтрНачинаетсяС(НизРег(Настройки.АдресСервера), "https"), Новый ЗащищенноеСоединениеOpenSSL(), Неопределено));
		
		Запрос = Новый HTTPЗапрос(Путь);
		Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		Запрос.Заголовки.Вставить("Accept", "application/json");
		
		Если ИспользоватьАвторизацию Тогда
			Токен = ПолучитьТокен();
			Если ЗначениеЗаполнено(Токен) Тогда
				Запрос.Заголовки.Вставить("Authorization", "Bearer " + Токен);
			КонецЕсли;
		КонецЕсли;
		
		Если Тело <> Неопределено Тогда
			Запрос.УстановитьТелоИзСтроки(СериализоватьJSON(Тело), КодировкаТекста.UTF8);
		КонецЕсли;
		
		Если Метод = "GET" Тогда
			ОтветHTTP = Соединение.Получить(Запрос);
		ИначеЕсли Метод = "POST" Тогда
			ОтветHTTP = Соединение.ОтправитьДляОбработки(Запрос);
		ИначеЕсли Метод = "PUT" Тогда
			ОтветHTTP = Соединение.Записать(Запрос);
		ИначеЕсли Метод = "DELETE" Тогда
			ОтветHTTP = Соединение.Удалить(Запрос);
		Иначе
			ВызватьИсключение "Непідтримуваний HTTP-метод: " + Метод;
		КонецЕсли;
		
		Результат.КодСостояния = ОтветHTTP.КодСостояния;
		
		// Повтор при 401 (прострочений токен) або 429 (rate limit)
		Если Результат.КодСостояния = 401 И ИспользоватьАвторизацию Тогда
			ПолучитьТокен(Истина);
			Возврат ВыполнитьЗапрос(Метод, Путь, Тело, ИспользоватьАвторизацию);
		КонецЕсли;
		
		Если Результат.КодСостояния = 429 Тогда
			Задержка = 5;
			RetryAfter = ОтветHTTP.Заголовки.Получить("Retry-After");
			Если RetryAfter <> Неопределено Тогда
				Задержка = Число(RetryAfter);
			КонецЕсли;
			// Пауза перед повтором (у регламентних завданнях допустимо)
		КонецЕсли;
		
		ТелоОтвета = ОтветHTTP.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
		Если ЗначениеЗаполнено(ТелоОтвета) Тогда
			Результат.Данные = ДесериализоватьJSON(ТелоОтвета);
		КонецЕсли;
		
	Исключение
		LC_ОбщегоНазначения.ЗаписатьВЖурнал(
			УровеньЖурналаРегистрации.Ошибка,
			"HTTP",
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Функция ИзвлечьХост(АдресСервера)
	Адрес = СтрЗаменить(АдресСервера, "https://", "");
	Адрес = СтрЗаменить(Адрес, "http://", "");
	ПозицияСлеша = СтрНайти(Адрес, "/");
	Если ПозицияСлеша > 0 Тогда
		Адрес = Лев(Адрес, ПозицияСлеша - 1);
	КонецЕсли;
	Возврат Адрес;
КонецФункции

Функция СериализоватьJSON(Данные)
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Данные);
	Возврат ЗаписьJSON.Закрыть();
	
КонецФункции

Функция ДесериализоватьJSON(СтрокаJSON)
	
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
	Возврат ПрочитатьJSON(ЧтениеJSON);
	
КонецФункции

#КонецОбласти
