////////////////////////////////////////////////////////////////////////////////
// Загальний модуль LC_СинхронизацияLoyalCards
// Сервер, зовнішнє з'єднання
// Синхронізація балансу з LOYAL CARDS API ПІСЛЯ рухів по регістрах BAS.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Додає контрагента в чергу синхронізації (викликається після проведення документа).
//
Процедура ЗапланироватьСинхронизацию(Контрагент) Экспорт
	
	Если Не ЗначениеЗаполнено(Контрагент) Тогда
		Возврат;
	КонецЕсли;
	
	Настройки = LC_ОбщегоНазначения.ПолучитьНастройкиИнтеграции();
	Если Не Настройки.ИспользоватьИнтеграцию Тогда
		Возврат;
	КонецЕсли;
	
	Баланс = LC_БонуснаяПрограммаСервер.ПолучитьБалансКлиента(Контрагент);
	
	МенеджерЗаписи = РегистрыСведений.LC_ОчередьСинхронизацииLoyalCards.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Контрагент = Контрагент;
	МенеджерЗаписи.ДатаИзменения = ТекущаяДатаСеанса();
	МенеджерЗаписи.ДоступныйБаланс = Баланс.Доступно;
	МенеджерЗаписи.Синхронизировано = Ложь;
	МенеджерЗаписи.ТекстОшибки = "";
	МенеджерЗаписи.Записать();
	
	// Спроба негайної синхронізації
	ВыполнитьСинхронизациюКонтрагента(Контрагент);
	
КонецПроцедуры

// Синхронізує баланс одного контрагента з API.
//
// Повертає:
//  Булево - Істина, якщо успішно.
//
Функция ВыполнитьСинхронизациюКонтрагента(Контрагент) Экспорт
	
	Настройки = LC_ОбщегоНазначения.ПолучитьНастройкиИнтеграции();
	Если Не Настройки.ИспользоватьИнтеграцию Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Карта = НайтиКартуLoyalCards(Контрагент);
	Если Не ЗначениеЗаполнено(Карта) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	SerialNumber = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Карта, "SerialNumber");
	Если Не ЗначениеЗаполнено(SerialNumber) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Баланс = LC_БонуснаяПрограммаСервер.ПолучитьБалансКлиента(Контрагент);
	ДоступныйБаланс = Баланс.Доступно;
	
	Успех = LC_LoyalCardsAPI.ОбновитьБаланс(SerialNumber, ДоступныйБаланс);
	
	Если Успех Тогда
		ОтметитьСинхронизированным(Контрагент, ДоступныйБаланс);
	Иначе
		ЗафиксироватьОшибкуСинхронизации(Контрагент, "Не вдалося оновити balance в Loyal Cards API");
	КонецЕсли;
	
	Возврат Успех;
	
КонецФункции

// Синхронізує рівень лояльності (discount) на картці.
//
Функция СинхронизироватьУровеньЛояльности(Контрагент) Экспорт
	
	Карта = НайтиКартуLoyalCards(Контрагент);
	Если Не ЗначениеЗаполнено(Карта) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	SerialNumber = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Карта, "SerialNumber");
	Уровень = LC_БонуснаяПрограммаСервер.ПолучитьУровеньЛояльностиКонтрагента(Контрагент);
	
	ПроцентСкидки = 0;
	Если ЗначениеЗаполнено(Уровень) Тогда
		ПроцентСкидки = Уровень.ПроцентСкидки;
	КонецЕсли;
	
	Возврат LC_LoyalCardsAPI.ОбновитьСкидку(SerialNumber, ПроцентСкидки);
	
КонецФункции

// Обробляє чергу несинхронізованих контрагентів (для регламенту / ручного запуску).
//
Процедура ОбработатьОчередьСинхронизации() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Очередь.Контрагент КАК Контрагент
	|ИЗ
	|	РегистрСведений.LC_ОчередьСинхронизацииLoyalCards КАК Очередь
	|ГДЕ
	|	НЕ Очередь.Синхронизировано";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ВыполнитьСинхронизациюКонтрагента(Выборка.Контрагент);
	КонецЦикла;
	
КонецПроцедуры

// Синхронізує баланси списку контрагентів (після регламенту активації/згоряння).
//
Процедура СинхронизироватьСписокКонтрагентов(МассивКонтрагентов) Экспорт
	
	Для Каждого Контрагент Из МассивКонтрагентов Цикл
		ЗапланироватьСинхронизацию(Контрагент);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НайтиКартуLoyalCards(Контрагент)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Карты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.LC_КартыLoyalCards КАК Карты
	|ГДЕ
	|	Карты.Владелец = &Контрагент
	|	И Карты.Статус = ЗНАЧЕНИЕ(Перечисление.LC_СтатусыКартыLoyalCards.Активна)
	|	И НЕ Карты.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Справочники.LC_КартыLoyalCards.ПустаяСсылка();
	
КонецФункции

Процедура ОтметитьСинхронизированным(Контрагент, Баланс)
	
	МенеджерЗаписи = РегистрыСведений.LC_ОчередьСинхронизацииLoyalCards.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Контрагент = Контрагент;
	МенеджерЗаписи.Прочитать();
	Если МенеджерЗаписи.Выбран() Тогда
		МенеджерЗаписи.Синхронизировано = Истина;
		МенеджерЗаписи.ДатаСинхронизации = ТекущаяДатаСеанса();
		МенеджерЗаписи.ДоступныйБаланс = Баланс;
		МенеджерЗаписи.ТекстОшибки = "";
		МенеджерЗаписи.Записать();
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗафиксироватьОшибкуСинхронизации(Контрагент, ТекстОшибки)
	
	МенеджерЗаписи = РегистрыСведений.LC_ОчередьСинхронизацииLoyalCards.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Контрагент = Контрагент;
	МенеджерЗаписи.Прочитать();
	Если МенеджерЗаписи.Выбран() Тогда
		МенеджерЗаписи.ТекстОшибки = ТекстОшибки;
		МенеджерЗаписи.Записать();
	КонецЕсли;
	
	LC_ОбщегоНазначения.ЗаписатьВЖурнал(
		УровеньЖурналаРегистрации.Предупреждение,
		"Sync",
		СтрШаблон("Помилка синхронізації для %1: %2", Контрагент, ТекстОшибки),
		Контрагент);
	
КонецПроцедуры

#КонецОбласти
