////////////////////////////////////////////////////////////////////////////////
// Загальний модуль LC_СинхронизацияLoyalCards
// Сервер, зовнішнє з'єднання
// Синхронізація балансу з LOYAL CARDS API ПІСЛЯ рухів по регістрах BAS.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Додає контрагента в чергу синхронізації (викликається після проведення документа).
//
Процедура ЗапланироватьСинхронизацию(Контрагент) Экспорт
	
	Если Не ЗначениеЗаполнено(Контрагент) Тогда
		Возврат;
	КонецЕсли;
	
	Настройки = LC_ОбщегоНазначения.ПолучитьНастройкиИнтеграции();
	Если Не Настройки.ИспользоватьИнтеграцию Тогда
		Возврат;
	КонецЕсли;
	
	Баланс = LC_БонуснаяПрограммаСервер.ПолучитьБалансКлиента(Контрагент);
	
	РегистрыСведений.LC_ОчередьСинхронизацииLoyalCards.ДобавитьВОчередь(Контрагент, Баланс.Доступно);
	
	// Спроба негайної синхронізації
	ВыполнитьСинхронизациюКонтрагента(Контрагент);
	
КонецПроцедуры

// Синхронізує баланс одного контрагента з API.
//
Функция ВыполнитьСинхронизациюКонтрагента(Контрагент) Экспорт
	
	Настройки = LC_ОбщегоНазначения.ПолучитьНастройкиИнтеграции();
	Если Не Настройки.ИспользоватьИнтеграцию Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Карта = Справочники.LC_КартыLoyalCards.НайтиПоКонтрагенту(Контрагент);
	Если Не ЗначениеЗаполнено(Карта) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	SerialNumber = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Карта, "SerialNumber");
	Если Не ЗначениеЗаполнено(SerialNumber) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Баланс = LC_БонуснаяПрограммаСервер.ПолучитьБалансКлиента(Контрагент);
	ДоступныйБаланс = Баланс.Доступно;
	
	Успех = LC_LoyalCardsAPI.ОбновитьБаланс(SerialNumber, ДоступныйБаланс);
	
	Если Успех Тогда
		РегистрыСведений.LC_ОчередьСинхронизацииLoyalCards.ОтметитьСинхронизированным(Контрагент, ДоступныйБаланс);
		ОбновитьДатуСинхронизацииКарты(Карта);
	Иначе
		РегистрыСведений.LC_ОчередьСинхронизацииLoyalCards.ЗафиксироватьОшибку(
			Контрагент, "Не вдалося оновити balance в Loyal Cards API");
		LC_ОбщегоНазначения.ЗаписатьВЖурнал(
			УровеньЖурналаРегистрации.Предупреждение,
			"Sync",
			СтрШаблон("Помилка синхронізації для %1", Контрагент),
			Контрагент);
	КонецЕсли;
	
	Возврат Успех;
	
КонецФункции

// Синхронізує рівень лояльності (discount) на картці.
//
Функция СинхронизироватьУровеньЛояльности(Контрагент) Экспорт
	
	Карта = Справочники.LC_КартыLoyalCards.НайтиПоКонтрагенту(Контрагент);
	Если Не ЗначениеЗаполнено(Карта) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	SerialNumber = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Карта, "SerialNumber");
	Уровень = LC_БонуснаяПрограммаСервер.ПолучитьУровеньЛояльностиКонтрагента(Контрагент);
	
	ПроцентСкидки = 0;
	Если ЗначениеЗаполнено(Уровень) Тогда
		ПроцентСкидки = Уровень.ПроцентСкидки;
	КонецЕсли;
	
	Возврат LC_LoyalCardsAPI.ОбновитьСкидку(SerialNumber, ПроцентСкидки);
	
КонецФункции

// Обробляє чергу несинхронізованих контрагентів.
//
Процедура ОбработатьОчередьСинхронизации() Экспорт
	
	ТаблицаОчереди = РегистрыСведений.LC_ОчередьСинхронизацииLoyalCards.ПолучитьНесинхронизированные();
	
	Для Каждого Строка Из ТаблицаОчереди Цикл
		ВыполнитьСинхронизациюКонтрагента(Строка.Контрагент);
	КонецЦикла;
	
КонецПроцедуры

// Синхронізує баланси списку контрагентів (після регламенту).
//
Процедура СинхронизироватьСписокКонтрагентов(МассивКонтрагентов) Экспорт
	
	Для Каждого Контрагент Из МассивКонтрагентов Цикл
		ЗапланироватьСинхронизацию(Контрагент);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ОбновитьДатуСинхронизацииКарты(Карта)
	
	Если Не ЗначениеЗаполнено(Карта) Тогда
		Возврат;
	КонецЕсли;
	
	КартаОбъект = Карта.ПолучитьОбъект();
	КартаОбъект.ДатаПоследнейСинхронизации = ТекущаяДатаСеанса();
	КартаОбъект.Записать();
	
КонецПроцедуры

#КонецОбласти
