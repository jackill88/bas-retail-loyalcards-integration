КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьПартииДляСписанияFIFO(Контрагент)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Остатки.ПартияБонусов КАК ПартияБонусов,
	|	Остатки.КоличествоОстаток КАК Количество,
	|	Партии.ДатаСгорания КАК ДатаСгорания
	|ИЗ
	|	РегистрНакопления.LC_БонусныеБаллыКлиентов.Остатки(
	|			,
	|			Контрагент = &Контрагент
	|				И СостояниеБонусов = ЗНАЧЕНИЕ(Перечисление.LC_СостоянияБонусов.Доступны)) КАК Остатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.LC_ПартииБонусов КАК Партии
	|		ПО Остатки.ПартияБонусов = Партии.ПартияБонусов
	|ГДЕ
	|	Остатки.КоличествоОстаток > 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаСгорания";
	
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция СоздатьПартиюБонусов(Контрагент, ДокументОбъект, Сумма, Уровень)
	
	ПартияОбъект = Справочники.LC_ПартииБонусов.СоздатьЭлемент();
	ПартияОбъект.Код = LC_ОбщегоНазначения.НовыйИдентификатор();
	ПартияОбъект.Владелец = Контрагент;
	ПартияОбъект.ДокументОснование = ДокументОбъект.Ссылка;
	ПартияОбъект.СуммаНачислена = Сумма;
	ПартияОбъект.Записать();
	
	Возврат ПартияОбъект.Ссылка;
	
КонецФункции

Процедура СформироватьДвижениеОборота(Движения, ДокументОбъект, Контрагент, ВидОперации, Количество)
	
	Движение = Движения.LC_БонусныеБаллыОборот.Добавить();
	Движение.Период = ДокументОбъект.Дата;
	Движение.Контрагент = Контрагент;
	Движение.ВидОперации = ВидОперации;
	Движение.Количество = Количество;
	
КонецПроцедуры

Процедура СформироватьДвижениеОборотаВДокументе(ДокументОперации, Контрагент, ВидОперации, Количество)
	
	Движение = ДокументОперации.Движения.LC_БонусныеБаллыОборот.Добавить();
	Движение.Период = ДокументОперации.Дата;
	Движение.Контрагент = Контрагент;
	Движение.ВидОперации = ВидОперации;
	Движение.Количество = Количество;
	
КонецПроцедуры

Функция СоздатьДокументОперации(ВидОперации, ДатаОперации, Комментарий)
	
	ДокументОбъект = Документы.LC_ОперацияБонусов.СоздатьДокумент();
	ДокументОбъект.Дата = ДатаОперации;
	ДокументОбъект.ВидОперации = ВидОперации;
	ДокументОбъект.Комментарий = Комментарий;
	
	Возврат ДокументОбъект;
	
КонецФункции

Процедура ОбновитьПризнакАктивацииПартии(ПартияБонусов, Значение)
	
	МенеджерЗаписи = РегистрыСведений.LC_ПартииБонусов.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ПартияБонусов = ПартияБонусов;
	МенеджерЗаписи.Прочитать();
	Если МенеджерЗаписи.Выбран() Тогда
		МенеджерЗаписи.Активирована = Значение;
		МенеджерЗаписи.Записать();
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбновитьПризнакСгоранияПартии(ПартияБонусов, Значение)
	
	МенеджерЗаписи = РегистрыСведений.LC_ПартииБонусов.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ПартияБонусов = ПартияБонусов;
	МенеджерЗаписи.Прочитать();
	Если МенеджерЗаписи.Выбран() Тогда
		МенеджерЗаписи.Сгорела = Значение;
		МенеджерЗаписи.Записать();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
