#Область ПрограммныйИнтерфейс

// Повертає структуру балансів клієнта з регістру накопичення.
//
// Повертає:
//  Структура - Доступно, ОжидаетАктивации, Всего.
//
Функция ПолучитьБалансКлиента(Контрагент) Экспорт
	
	Результат = Новый Структура("Доступно, ОжидаетАктивации, Всего", 0, 0, 0);
	
	Если Не ЗначениеЗаполнено(Контрагент) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Остатки.СостояниеБонусов КАК СостояниеБонусов,
	|	Остатки.КоличествоОстаток КАК Количество
	|ИЗ
	|	РегистрНакопления.LC_БонусныеБаллыКлиентов.Остатки(
	|			,
	|			Контрагент = &Контрагент) КАК Остатки
	|ГДЕ
	|	Остатки.КоличествоОстаток > 0";
	
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.СостояниеБонусов = Перечисления.LC_СостоянияБонусов.Доступны Тогда
			Результат.Доступно = Результат.Доступно + Выборка.Количество;
		ИначеЕсли Выборка.СостояниеБонусов = Перечисления.LC_СостоянияБонусов.ОжидаетАктивации Тогда
			Результат.ОжидаетАктивации = Результат.ОжидаетАктивации + Выборка.Количество;
		КонецЕсли;
	КонецЦикла;
	
	Результат.Всего = Результат.Доступно + Результат.ОжидаетАктивации;
	
	Возврат Результат;
	
КонецФункции

// Розраховує максимальну суму списання бонусів для чека.
//
Функция РассчитатьМаксимальноеСписание(Контрагент, СуммаЧека, УровеньЛояльности = Неопределено) Экспорт
	
	Баланс = ПолучитьБалансКлиента(Контрагент);
	Доступно = Баланс.Доступно;
	
	Если Доступно <= 0 Или СуммаЧека <= 0 Тогда
		Возврат 0;
	КонецЕсли;
	
	ПроцентСписания = 20;
	Если ЗначениеЗаполнено(УровеньЛояльности) Тогда
		ПроцентСписания = УровеньЛояльности.МаксимальныйПроцентСписания;
	Иначе
		Уровень = ПолучитьУровеньЛояльностиКонтрагента(Контрагент);
		Если ЗначениеЗаполнено(Уровень) Тогда
			ПроцентСписания = Уровень.МаксимальныйПроцентСписания;
		КонецЕсли;
	КонецЕсли;
	
	ЛимитПоЧеку = LC_ОбщегоНазначения.ОкруглитьБонусы(СуммаЧека * ПроцентСписания / 100);
	
	Возврат Мин(Доступно, ЛимитПоЧеку);
	
КонецФункции

// Розраховує суму нарахування бонусів.
//
Функция РассчитатьНачисление(СуммаЧека, СуммаСписанияБонусов, УровеньЛояльности) Экспорт
	
	БазаНачисления = СуммаЧека - СуммаСписанияБонусов;
	Если БазаНачисления <= 0 Тогда
		Возврат 0;
	КонецЕсли;
	
	ПроцентНачисления = 5;
	Если ЗначениеЗаполнено(УровеньЛояльности) Тогда
		ПроцентНачисления = УровеньЛояльности.ПроцентНачисления;
	КонецЕсли;
	
	Возврат LC_ОбщегоНазначения.ОкруглитьБонусы(БазаНачисления * ПроцентНачисления / 100);
	
КонецФункции

// Формує рухи списання бонусів (FIFO) при проведенні чека.
//
Процедура СформироватьДвиженияСписания(ДокументОбъект, Движения) Экспорт
	
	Контрагент = ДокументОбъект.LC_КонтрагентБонуснойПрограммы;
	СуммаСписания = ДокументОбъект.LC_СуммаСписанияБонусов;
	
	Если Не ЗначениеЗаполнено(Контрагент) Или СуммаСписания <= 0 Тогда
		Возврат;
	КонецЕсли;
	
	ОстатокСписать = СуммаСписания;
	Партии = ПолучитьПартииДляСписанияFIFO(Контрагент);
	
	НаборЗаписей = Движения.LC_БонусныеБаллыКлиентов;
	
	Для Каждого СтрокаПартии Из Партии Цикл
		
		Если ОстатокСписать <= 0 Тогда
			Прервать;
		КонецЕсли;
		
		СписатьИзПартии = Мин(СтрокаПартии.Количество, ОстатокСписать);
		
		Движение = НаборЗаписей.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = ДокументОбъект.Дата;
		Движение.Контрагент = Контрагент;
		Движение.ПартияБонусов = СтрокаПартии.ПартияБонусов;
		Движение.СостояниеБонусов = Перечисления.LC_СостоянияБонусов.Доступны;
		Движение.Количество = СписатьИзПартии;
		
		СформироватьДвижениеОборота(Движения, ДокументОбъект, Контрагент,
			Перечисления.LC_ВидыБонусныхОпераций.Списание, СписатьИзПартии);
		
		ОстатокСписать = ОстатокСписать - СписатьИзПартии;
		
	КонецЦикла;
	
	Если ОстатокСписать > 0 Тогда
		ВызватьИсключение СтрШаблон(
			"Недостатньо доступних бонусів для списання. Не вистачає: %1",
			ОстатокСписать);
	КонецЕсли;
	
КонецПроцедуры

// Формує рухи нарахування бонусів (стан «очікує активації») при проведенні чека.
//
Процедура СформироватьДвиженияНачисления(ДокументОбъект, Движения) Экспорт
	
	Контрагент = ДокументОбъект.LC_КонтрагентБонуснойПрограммы;
	СуммаНачисления = ДокументОбъект.LC_СуммаНачисленияБонусов;
	
	Если Не ЗначениеЗаполнено(Контрагент) Или СуммаНачисления <= 0 Тогда
		Возврат;
	КонецЕсли;
	
	Уровень = ПолучитьУровеньЛояльностиКонтрагента(Контрагент);
	Партия = СоздатьПартиюБонусов(Контрагент, ДокументОбъект, СуммаНачисления, Уровень);
	
	// Рух по регістру накопичення — прихід у «очікування»
	Движение = Движения.LC_БонусныеБаллыКлиентов.Добавить();
	Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
	Движение.Период = ДокументОбъект.Дата;
	Движение.Контрагент = Контрагент;
	Движение.ПартияБонусов = Партия;
	Движение.СостояниеБонусов = Перечисления.LC_СостоянияБонусов.ОжидаетАктивации;
	Движение.Количество = СуммаНачисления;
	
	СформироватьДвижениеОборота(Движения, ДокументОбъект, Контрагент,
		Перечисления.LC_ВидыБонусныхОпераций.Начисление, СуммаНачисления);
	
	// Запис у регістр відомостей — метадані партії
	ЗаписьПартии = Движения.LC_ПартииБонусов.Добавить();
	ЗаписьПартии.ПартияБонусов = Партия;
	ЗаписьПартии.Контрагент = Контрагент;
	ЗаписьПартии.ДокументОснование = ДокументОбъект.Ссылка;
	ЗаписьПартии.ДатаНачисления = НачалоДня(ДокументОбъект.Дата);
	
	ДнейДоАктивации = ?(ЗначениеЗаполнено(Уровень), Уровень.ДнейДоАктивации, 14);
	МесяцевДействия = ?(ЗначениеЗаполнено(Уровень), Уровень.МесяцевДействия, 4);
	
	ЗаписьПартии.ДатаАктивации = LC_ОбщегоНазначения.ДобавитьКалендарныеДни(
		ЗаписьПартии.ДатаНачисления, ДнейДоАктивации);
	ЗаписьПартии.ДатаСгорания = LC_ОбщегоНазначения.ДобавитьКалендарныеМесяцы(
		ЗаписьПартии.ДатаАктивации, МесяцевДействия);
	ЗаписьПартии.СуммаНачислена = СуммаНачисления;
	ЗаписьПартии.УровеньЛояльности = Уровень;
	ЗаписьПартии.Активирована = Ложь;
	ЗаписьПартии.Сгорела = Ложь;
	
КонецПроцедуры

// Сторно всіх рухів бонусів документа (скасування проведення).
//
Процедура СформироватьСторноДвижений(ДокументСсылка, Движения) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Движения.Период КАК Период,
	|	Движения.Контрагент КАК Контрагент,
	|	Движения.ПартияБонусов КАК ПартияБонусов,
	|	Движения.СостояниеБонусов КАК СостояниеБонусов,
	|	Движения.Количество КАК Количество,
	|	Движения.ВидДвижения КАК ВидДвижения
	|ИЗ
	|	РегистрНакопления.LC_БонусныеБаллыКлиентов КАК Движения
	|ГДЕ
	|	Движения.Регистратор = &Регистратор";
	
	Запрос.УстановитьПараметр("Регистратор", ДокументСсылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Движение = Движения.LC_БонусныеБаллыКлиентов.Добавить();
		Движение.Период = ТекущаяДатаСеанса();
		Движение.Контрагент = Выборка.Контрагент;
		Движение.ПартияБонусов = Выборка.ПартияБонусов;
		Движение.СостояниеБонусов = Выборка.СостояниеБонусов;
		Движение.Количество = Выборка.Количество;
		
		Если Выборка.ВидДвижения = ВидДвиженияНакопления.Приход Тогда
			Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Иначе
			Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Активація партій, термін яких настав (викликається з регламенту).
//
// Повертає:
//  Массив - контрагенти, по яких змінився баланс (для синхронізації).
//
Функция ВыполнитьАктивациюПартий(ДатаОперации) Экспорт
	
	ЗатронутыеКонтрагенты = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Партии.ПартияБонусов КАК ПартияБонусов,
	|	Партии.Контрагент КАК Контрагент,
	|	Остатки.КоличествоОстаток КАК Количество
	|ИЗ
	|	РегистрСведений.LC_ПартииБонусов КАК Партии
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.LC_БонусныеБаллыКлиентов.Остатки(
	|				&ДатаОперации,
	|				СостояниеБонусов = ЗНАЧЕНИЕ(Перечисление.LC_СостоянияБонусов.ОжидаетАктивации)) КАК Остатки
	|		ПО Партии.ПартияБонусов = Остатки.ПартияБонусов
	|			И Партии.Контрагент = Остатки.Контрагент
	|ГДЕ
	|	Партии.ДатаАктивации <= &ДатаОперации
	|	И НЕ Партии.Активирована
	|	И Остатки.КоличествоОстаток > 0";
	
	Запрос.УстановитьПараметр("ДатаОперации", ДатаОперации);
	
	ТаблицаПартий = Запрос.Выполнить().Выгрузить();
	Если ТаблицаПартий.Количество() = 0 Тогда
		Возврат ЗатронутыеКонтрагенты;
	КонецЕсли;
	
	ДокументОперации = СоздатьДокументОперации(
		Перечисления.LC_ВидыБонусныхОпераций.Активация,
		ДатаОперации,
		"Автоматична активація бонусів");
	
	Для Каждого Строка Из ТаблицаПартий Цикл
		
		// Расход з «очікування»
		ДвижениеРасход = ДокументОперации.Движения.LC_БонусныеБаллыКлиентов.Добавить();
		ДвижениеРасход.ВидДвижения = ВидДвиженияНакопления.Расход;
		ДвижениеРасход.Период = ДатаОперации;
		ДвижениеРасход.Контрагент = Строка.Контрагент;
		ДвижениеРасход.ПартияБонусов = Строка.ПартияБонусов;
		ДвижениеРасход.СостояниеБонусов = Перечисления.LC_СостоянияБонусов.ОжидаетАктивации;
		ДвижениеРасход.Количество = Строка.Количество;
		
		// Прихід у «доступні»
		ДвижениеПриход = ДокументОперации.Движения.LC_БонусныеБаллыКлиентов.Добавить();
		ДвижениеПриход.ВидДвижения = ВидДвиженияНакопления.Приход;
		ДвижениеПриход.Период = ДатаОперации;
		ДвижениеПриход.Контрагент = Строка.Контрагент;
		ДвижениеПриход.ПартияБонусов = Строка.ПартияБонусов;
		ДвижениеПриход.СостояниеБонусов = Перечисления.LC_СостоянияБонусов.Доступны;
		ДвижениеПриход.Количество = Строка.Количество;
		
		СформироватьДвижениеОборотаВДокументе(ДокументОперации, Строка.Контрагент,
			Перечисления.LC_ВидыБонусныхОпераций.Активация, Строка.Количество);
		
		ОбновитьПризнакАктивацииПартии(Строка.ПартияБонусов, Истина);
		
		Если ЗатронутыеКонтрагенты.Найти(Строка.Контрагент) = Неопределено Тогда
			ЗатронутыеКонтрагенты.Добавить(Строка.Контрагент);
		КонецЕсли;
		
	КонецЦикла;
	
	ДокументОперации.Записать(РежимЗаписиДокумента.Проведение);
	
	Возврат ЗатронутыеКонтрагенты;
	
КонецФункции

// Згоряння прострочених бонусів (викликається з регламенту о 00:00).
//
Функция ВыполнитьСгораниеПартий(ДатаОперации) Экспорт
	
	ЗатронутыеКонтрагенты = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Партии.ПартияБонусов КАК ПартияБонусов,
	|	Партии.Контрагент КАК Контрагент,
	|	Остатки.КоличествоОстаток КАК Количество
	|ИЗ
	|	РегистрСведений.LC_ПартииБонусов КАК Партии
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.LC_БонусныеБаллыКлиентов.Остатки(
	|				&ДатаОперации,
	|				СостояниеБонусов = ЗНАЧЕНИЕ(Перечисление.LC_СостоянияБонусов.Доступны)) КАК Остатки
	|		ПО Партии.ПартияБонусов = Остатки.ПартияБонусов
	|			И Партии.Контрагент = Остатки.Контрагент
	|ГДЕ
	|	Партии.ДатаСгорания < &ДатаОперации
	|	И НЕ Партии.Сгорела
	|	И Остатки.КоличествоОстаток > 0";
	
	Запрос.УстановитьПараметр("ДатаОперации", НачалоДня(ДатаОперации));
	
	ТаблицаПартий = Запрос.Выполнить().Выгрузить();
	Если ТаблицаПартий.Количество() = 0 Тогда
		Возврат ЗатронутыеКонтрагенты;
	КонецЕсли;
	
	ДокументОперации = СоздатьДокументОперации(
		Перечисления.LC_ВидыБонусныхОпераций.Сгорание,
		ДатаОперации,
		"Автоматичне згоряння бонусів");
	
	Для Каждого Строка Из ТаблицаПартий Цикл
		
		Движение = ДокументОперации.Движения.LC_БонусныеБаллыКлиентов.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = ДатаОперации;
		Движение.Контрагент = Строка.Контрагент;
		Движение.ПартияБонусов = Строка.ПартияБонусов;
		Движение.СостояниеБонусов = Перечисления.LC_СостоянияБонусов.Доступны;
		Движение.Количество = Строка.Количество;
		
		СформироватьДвижениеОборотаВДокументе(ДокументОперации, Строка.Контрагент,
			Перечисления.LC_ВидыБонусныхОпераций.Сгорание, Строка.Количество);
		
		ОбновитьПризнакСгоранияПартии(Строка.ПартияБонусов, Истина);
		
		Если ЗатронутыеКонтрагенты.Найти(Строка.Контрагент) = Неопределено Тогда
			ЗатронутыеКонтрагенты.Добавить(Строка.Контрагент);
		КонецЕсли;
		
	КонецЦикла;
	
	ДокументОперации.Записать(РежимЗаписиДокумента.Проведение);
	
	Возврат ЗатронутыеКонтрагенты;
	
КонецФункции

// Скасування нарахування при поверненні товару.
//
Процедура СформироватьДвиженияОтменыНачисления(ДокументОбъект, ЧекОснование, Движения, КоэффициентВозврата = 1) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Движения.Контрагент КАК Контрагент,
	|	Движения.ПартияБонусов КАК ПартияБонусов,
	|	Движения.СостояниеБонусов КАК СостояниеБонусов,
	|	Движения.Количество КАК Количество
	|ИЗ
	|	РегистрНакопления.LC_БонусныеБаллыКлиентов КАК Движения
	|ГДЕ
	|	Движения.Регистратор = &ЧекОснование
	|	И Движения.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|	И Движения.СостояниеБонусов = ЗНАЧЕНИЕ(Перечисление.LC_СостоянияБонусов.ОжидаетАктивации)";
	
	Запрос.УстановитьПараметр("ЧекОснование", ЧекОснование);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		КоличествоОтмены = LC_ОбщегоНазначения.ОкруглитьБонусы(Выборка.Количество * КоэффициентВозврата);
		Если КоличествоОтмены <= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Движение = Движения.LC_БонусныеБаллыКлиентов.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = ДокументОбъект.Дата;
		Движение.Контрагент = Выборка.Контрагент;
		Движение.ПартияБонусов = Выборка.ПартияБонусов;
		Движение.СостояниеБонусов = Выборка.СостояниеБонусов;
		Движение.Количество = КоличествоОтмены;
		
		СформироватьДвижениеОборота(Движения, ДокументОбъект, Выборка.Контрагент,
			Перечисления.LC_ВидыБонусныхОпераций.ОтменаНачисления, КоличествоОтмены);
		
	КонецЦикла;
	
КонецПроцедуры

// Повернення раніше списаних бонусів при поверненні товару.
//
Процедура СформироватьДвиженияВозвратаСписания(ДокументОбъект, ЧекОснование, Движения, КоэффициентВозврата = 1) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Движения.Контрагент КАК Контрагент,
	|	Движения.ПартияБонусов КАК ПартияБонусов,
	|	Движения.Количество КАК Количество
	|ИЗ
	|	РегистрНакопления.LC_БонусныеБаллыКлиентов КАК Движения
	|ГДЕ
	|	Движения.Регистратор = &ЧекОснование
	|	И Движения.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|	И Движения.СостояниеБонусов = ЗНАЧЕНИЕ(Перечисление.LC_СостоянияБонусов.Доступны)";
	
	Запрос.УстановитьПараметр("ЧекОснование", ЧекОснование);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		КоличествоВозврата = LC_ОбщегоНазначения.ОкруглитьБонусы(Выборка.Количество * КоэффициентВозврата);
		Если КоличествоВозврата <= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Движение = Движения.LC_БонусныеБаллыКлиентов.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период = ДокументОбъект.Дата;
		Движение.Контрагент = Выборка.Контрагент;
		Движение.ПартияБонусов = Выборка.ПартияБонусов;
		Движение.СостояниеБонусов = Перечисления.LC_СостоянияБонусов.Доступны;
		Движение.Количество = КоличествоВозврата;
		
		СформироватьДвижениеОборота(Движения, ДокументОбъект, Выборка.Контрагент,
			Перечисления.LC_ВидыБонусныхОпераций.ВозвратСписания, КоличествоВозврата);
		
	КонецЦикла;
	
КонецПроцедуры

