#Область ПрограммныйИнтерфейс

// Нормалізує номер телефону до формату 380XXXXXXXXX (без +).
//
// Параметри:
//  Телефон - Рядок - вхідний номер у довільному форматі.
//
// Повертає:
//  Рядок - нормалізований номер або порожній рядок.
//
Функция НормализоватьТелефон(Телефон) Экспорт
	
	Результат = "";
	Цифры = "";
	
	Для Индекс = 1 По СтрДлина(Телефон) Цикл
		Символ = Сред(Телефон, Индекс, 1);
		Если Символ >= "0" И Символ <= "9" Тогда
			Цифры = Цифры + Символ;
		КонецЕсли;
	КонецЦикла;
	
	Если СтрДлина(Цифры) = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если СтрДлина(Цифры) = 10 И Лев(Цифры, 1) = "0" Тогда
		Результат = "38" + Цифры;
	ИначеЕсли СтрДлина(Цифры) = 9 Тогда
		Результат = "380" + Цифры;
	ИначеЕсли СтрДлина(Цифры) = 12 И Лев(Цифры, 2) = "38" Тогда
		Результат = Цифры;
	ИначеЕсли СтрДлина(Цифры) = 11 И Лев(Цифры, 1) = "8" Тогда
		Результат = "3" + Цифры;
	Иначе
		Результат = Цифры;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Округлення суми бонусів до 2 знаків (копійки).
//
Функция ОкруглитьБонусы(Сумма) Экспорт
	Возврат Окр(Сумма, 2, РежимОкругления.Окр15как20);
КонецФункции

// Додає календарні дні до дати.
//
Функция ДобавитьКалендарныеДни(Дата, КоличествоДней) Экспорт
	Возврат НачалоДня(Дата) + КоличествоДней * 86400;
КонецФункции

// Додає календарні місяці до дати (для терміну дії бонусів).
//
Функция ДобавитьКалендарныеМесяцы(Дата, КоличествоМесяцев) Экспорт
	Возврат ДобавитьМесяц(НачалоДня(Дата), КоличествоМесяцев);
КонецФункции

// Повертає новий UUID у вигляді рядка.
//
Функция НовыйИдентификатор() Экспорт
	Возврат Строка(Новый УникальныйИдентификатор);
КонецФункции

// Читає налаштування інтеграції з констант.
//
// Повертає:
//  Структура - поля: АдресСервера, Email, Пароль, PassTypeIdentifier, TemplateId,
//              OrganisationId, ТаймаутСек, ИспользоватьИнтеграцию.
//
Функция ПолучитьНастройкиИнтеграции() Экспорт
	
	Настройки = Новый Структура;
	Настройки.Вставить("АдресСервера", Константы.LC_АдресСервераLoyalCards.Получить());
	Настройки.Вставить("Email", Константы.LC_EmailLoyalCards.Получить());
	Настройки.Вставить("Пароль", Константы.LC_ПарольLoyalCards.Получить());
	Настройки.Вставить("PassTypeIdentifier", Константы.LC_PassTypeIdentifier.Получить());
	Настройки.Вставить("TemplateId", Константы.LC_TemplateId.Получить());
	Настройки.Вставить("OrganisationId", Константы.LC_OrganisationId.Получить());
	Настройки.Вставить("ТаймаутСек", Константы.LC_ТаймаутЗапросаСек.Получить());
	Настройки.Вставить("ИспользоватьИнтеграцию", Константы.LC_ИспользоватьИнтеграциюLoyalCards.Получить());
	
	Если Настройки.ТаймаутСек = 0 Тогда
		Настройки.ТаймаутСек = 30;
	КонецЕсли;
	
	Возврат Настройки;
	
КонецФункции

// Записує текст у журнал реєстрації інтеграції.
//
Процедура ЗаписатьВЖурнал(Уровень, Событие, Комментарий, Данные = Неопределено) Экспорт
	
	ЗаписьЖурналаРегистрации(
		"LC.LoyalCards." + Событие,
		Уровень,
		,
		Данные,
		Комментарий);
	
КонецПроцедуры

#КонецОбласти
