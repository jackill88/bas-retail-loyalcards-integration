////////////////////////////////////////////////////////////////////////////////
// Загальний модуль LC_БонуснаяПрограммаКлиент
// Клієнт
// UI-логіка каси: ідентифікація клієнта, відображення балансу, списання бонусів.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Обробник введення телефону на формі чека.
//
Процедура ИдентифицироватьПоТелефону(Форма, Телефон) Экспорт
	
	Результат = LC_ИнтеграцияЧекККМ.ИдентифицироватьКлиента(
		ПредопределенноеЗначение("Перечисление.LC_СпособыИдентификацииКлиента.Телефон"),
		Телефон);
	
	ПрименитьИдентификациюКФорме(Форма, Результат,
		ПредопределенноеЗначение("Перечисление.LC_СпособыИдентификацииКлиента.Телефон"));
	
КонецПроцедуры

// Обробник сканування QR / штрихкоду картки.
//
Процедура ИдентифицироватьПоШтрихкоду(Форма, Штрихкод) Экспорт
	
	// QR може містити serialNumber (UUID) або memberId (номер картки)
	Способ = ПредопределенноеЗначение("Перечисление.LC_СпособыИдентификацииКлиента.QRКод");
	
	Если СтрДлина(Штрихкод) = 36 И СтрНайти(Штрихкод, "-") > 0 Тогда
		Способ = ПредопределенноеЗначение("Перечисление.LC_СпособыИдентификацииКлиента.SerialNumber");
	ИначеЕсли СтрДлина(Штрихкод) = 13 И ТолькоЦифры(Штрихкод) Тогда
		Способ = ПредопределенноеЗначение("Перечисление.LC_СпособыИдентификацииКлиента.НомерКарты");
	КонецЕсли;
	
	Результат = LC_ИнтеграцияЧекККМ.ИдентифицироватьКлиента(Способ, Штрихкод);
	ПрименитьИдентификациюКФорме(Форма, Результат, Способ);
	
КонецПроцедуры

// Оновлює відображення балансу на формі чека.
//
Процедура ОбновитьОтображениеБаланса(Форма) Экспорт
	
	Объект = Форма.Объект;
	
	Если Не ЗначениеЗаполнено(Объект.LC_КонтрагентБонуснойПрограммы) Тогда
		Форма.Элементы.LC_ГруппаБонусы.Видимость = Ложь;
		Возврат;
	КонецЕсли;
	
	Баланс = LC_БонуснаяПрограммаСервер.ПолучитьБалансКлиента(Объект.LC_КонтрагентБонуснойПрограммы);
	
	Форма.LC_ДоступноБонусов = Баланс.Доступно;
	Форма.LC_ОжидаетАктивации = Баланс.ОжидаетАктивации;
	Форма.LC_ВсегоБонусов = Баланс.Всего;
	Форма.Элементы.LC_ГруппаБонусы.Видимость = Истина;
	
	СуммаЧека = Объект.СуммаДокумента;
	МаксСписание = LC_БонуснаяПрограммаСервер.РассчитатьМаксимальноеСписание(
		Объект.LC_КонтрагентБонуснойПрограммы, СуммаЧека);
	
	Форма.LC_МаксСписание = МаксСписание;
	
КонецПроцедуры

// Застосовує суму списання бонусів, введену касиром.
//
Процедура ПрименитьСписаниеБонусов(Форма, СуммаСписания) Экспорт
	
	Объект = Форма.Объект;
	
	МаксСписание = Форма.LC_МаксСписание;
	Если СуммаСписания > МаксСписание Тогда
		СуммаСписания = МаксСписание;
		ПоказатьПредупреждение(, СтрШаблон(
			"Максимальне списання для цього чека: %1 бонусів", МаксСписание));
	КонецЕсли;
	
	Объект.LC_СуммаСписанияБонусов = СуммаСписания;
	LC_ИнтеграцияЧекККМ.ПодготовитьЧекКНачислению(Объект);
	
	Форма.LC_СуммаНачисления = Объект.LC_СуммаНачисленияБонусов;
	
КонецПроцедуры

// Скидає дані бонусної програми в чеку.
//
Процедура СброситьБонусы(Форма) Экспорт
	
	Объект = Форма.Объект;
	Объект.LC_КонтрагентБонуснойПрограммы = ПредопределенноеЗначение("Справочник.Контрагенты.ПустаяСсылка");
	Объект.LC_КартаLoyalCards = ПредопределенноеЗначение("Справочник.LC_КартыLoyalCards.ПустаяСсылка");
	Объект.LC_СуммаСписанияБонусов = 0;
	Объект.LC_СуммаНачисленияБонусов = 0;
	Объект.LC_СпособИдентификации = ПредопределенноеЗначение("Перечисление.LC_СпособыИдентификацииКлиента.ПустаяСсылка");
	
	Форма.Элементы.LC_ГруппаБонусы.Видимость = Ложь;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПрименитьИдентификациюКФорме(Форма, Результат, Способ)
	
	Если Не ЗначениеЗаполнено(Результат.Контрагент) Тогда
		ПоказатьПредупреждение(, "Клієнта не знайдено в бонусній програмі.");
		Возврат;
	КонецЕсли;
	
	Объект = Форма.Объект;
	Объект.LC_КонтрагентБонуснойПрограммы = Результат.Контрагент;
	Объект.LC_КартаLoyalCards = Результат.КартаLoyalCards;
	Объект.LC_СпособИдентификации = Способ;
	
	ОбновитьОтображениеБаланса(Форма);
	
КонецПроцедуры

Функция ТолькоЦифры(Строка)
	
	Для Индекс = 1 По СтрДлина(Строка) Цикл
		Символ = Сред(Строка, Индекс, 1);
		Если Символ < "0" Или Символ > "9" Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

#КонецОбласти
