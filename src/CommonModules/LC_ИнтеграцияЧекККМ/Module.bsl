////////////////////////////////////////////////////////////////////////////////
// Загальний модуль LC_ИнтеграцияЧекККМ
// Сервер
// Обробники проведення документів продажу та повернення.
// Порядок: рухи по регістрах → синхронізація з API.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Підписка: ЧекККМ.ОбработкаПроведения
//
Процедура ЧекККМ_ОбработкаПроведения(Источник, Отказ, РежимПроведения) Экспорт
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ИспользуетсяБонуснаяПрограмма(Источник) Тогда
		Возврат;
	КонецЕсли;
	
	Движения = Источник.Движения;
	Движения.LC_БонусныеБаллыКлиентов.Записывать = Истина;
	Движения.LC_БонусныеБаллыОборот.Записывать = Истина;
	Движения.LC_ПартииБонусов.Записывать = Истина;
	
	// 1. Списання бонусів (якщо касир обрав списання)
	LC_БонуснаяПрограммаСервер.СформироватьДвиженияСписания(Источник, Движения);
	
	// 2. Нарахування нових бонусів (5% від грошової частини)
	LC_БонуснаяПрограммаСервер.СформироватьДвиженияНачисления(Источник, Движения);
	
	// 3. Синхронізація balance з API — після запису рухів (OnWrite / після проведення)
	//    Викликається в ЧекККМ_ПриЗаписи после успішного проведення
	
КонецПроцедуры

// Підписка: ЧекККМ.ОбработкаУдаленияПроведения
//
Процедура ЧекККМ_ОбработкаУдаленияПроведения(Источник, Отказ) Экспорт
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Источник.LC_КонтрагентБонуснойПрограммы) Тогда
		Возврат;
	КонецЕсли;
	
	Движения = Источник.Движения;
	Движения.LC_БонусныеБаллыКлиентов.Записывать = Истина;
	Движения.LC_БонусныеБаллыОборот.Записывать = Истина;
	
	LC_БонуснаяПрограммаСервер.СформироватьСторноДвижений(Источник.Ссылка, Движения);
	
КонецПроцедуры

// Підписка: ЧекККМ.ПриЗаписи (після успішного проведення)
//
Процедура ЧекККМ_ПриЗаписи(Источник, Отказ) Экспорт
	
	Если Отказ Или Не Источник.Проведен Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Источник.LC_КонтрагентБонуснойПрограммы) Тогда
		Возврат;
	КонецЕсли;
	
	LC_СинхронизацияLoyalCards.ЗапланироватьСинхронизацию(Источник.LC_КонтрагентБонуснойПрограммы);
	
КонецПроцедуры

// Підписка: ЧекККМ.ОбработкаУдаленияПроведения — після скасування
//
Процедура ЧекККМ_ПослеОтменыПроведения(Источник) Экспорт
	
	Если ЗначениеЗаполнено(Источник.LC_КонтрагентБонуснойПрограммы) Тогда
		LC_СинхронизацияLoyalCards.ЗапланироватьСинхронизацию(Источник.LC_КонтрагентБонуснойПрограммы);
	КонецЕсли;
	
КонецПроцедуры

// Підписка: ВозвратТоваровОтПокупателя.ОбработкаПроведения
//
Процедура Возврат_ОбработкаПроведения(Источник, Отказ, РежимПроведения) Экспорт
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ЧекОснование = ПолучитьЧекОснованиеВозврата(Источник);
	Если Не ЗначениеЗаполнено(ЧекОснование) Тогда
		Возврат;
	КонецЕсли;
	
	Коэффициент = РассчитатьКоэффициентВозврата(Источник, ЧекОснование);
	Если Коэффициент <= 0 Тогда
		Возврат;
	КонецЕсли;
	
	Движения = Источник.Движения;
	Движения.LC_БонусныеБаллыКлиентов.Записывать = Истина;
	Движения.LC_БонусныеБаллыОборот.Записывать = Истина;
	
	// Скасування нарахування за оригінальним чеком
	LC_БонуснаяПрограммаСервер.СформироватьДвиженияОтменыНачисления(
		Источник, ЧекОснование, Движения, Коэффициент);
	
	// Повернення раніше списаних бонусів
	LC_БонуснаяПрограммаСервер.СформироватьДвиженияВозвратаСписания(
		Источник, ЧекОснование, Движения, Коэффициент);
	
КонецПроцедуры

// Підписка: ВозвратТоваровОтПокупателя.ПриЗаписи
//
Процедура Возврат_ПриЗаписи(Источник, Отказ) Экспорт
	
	Если Отказ Или Не Источник.Проведен Тогда
		Возврат;
	КонецЕсли;
	
	ЧекОснование = ПолучитьЧекОснованиеВозврата(Источник);
	Если Не ЗначениеЗаполнено(ЧекОснование) Тогда
		Возврат;
	КонецЕсли;
	
	Контрагент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЧекОснование, "LC_КонтрагентБонуснойПрограммы");
	Если ЗначениеЗаполнено(Контрагент) Тогда
		LC_СинхронизацияLoyalCards.ЗапланироватьСинхронизацию(Контрагент);
	КонецЕсли;
	
КонецПроцедуры

// Заповнює реквізити бонусної програми в чеку перед проведенням.
// Викликається з форми каси.
//
Процедура ПодготовитьЧекКНачислению(ДокументОбъект) Экспорт
	
	Контрагент = ДокументОбъект.LC_КонтрагентБонуснойПрограммы;
	Если Не ЗначениеЗаполнено(Контрагент) Тогда
		ДокументОбъект.LC_СуммаНачисленияБонусов = 0;
		Возврат;
	КонецЕсли;
	
	СуммаЧека = ПолучитьСуммуЧека(ДокументОбъект);
	Уровень = LC_БонуснаяПрограммаСервер.ПолучитьУровеньЛояльностиКонтрагента(Контрагент);
	
	// Перевірка/обмеження списання
	МаксСписание = LC_БонуснаяПрограммаСервер.РассчитатьМаксимальноеСписание(
		Контрагент, СуммаЧека, Уровень);
	
	Если ДокументОбъект.LC_СуммаСписанияБонусов > МаксСписание Тогда
		ДокументОбъект.LC_СуммаСписанияБонусов = МаксСписание;
	КонецЕсли;
	
	ДокументОбъект.LC_СуммаНачисленияБонусов = LC_БонуснаяПрограммаСервер.РассчитатьНачисление(
		СуммаЧека, ДокументОбъект.LC_СуммаСписанияБонусов, Уровень);
	
КонецПроцедуры

// Ідентифікація клієнта за телефоном, QR або номером картки.
//
// Повертає:
//  Структура - Контрагент, КартаLoyalCards, Баланс (Доступно, ОжидаетАктивации, Всего).
//
Функция ИдентифицироватьКлиента(СпособИдентификации, Значение) Экспорт
	
	Результат = Новый Структура("Контрагент, КартаLoyalCards, Баланс",
		Справочники.Контрагенты.ПустаяСсылка(),
		Справочники.LC_КартыLoyalCards.ПустаяСсылка(),
		Новый Структура("Доступно, ОжидаетАктивации, Всего", 0, 0, 0));
	
	Если СпособИдентификации = Перечисления.LC_СпособыИдентификацииКлиента.Телефон Тогда
		
		НормТелефон = LC_ОбщегоНазначения.НормализоватьТелефон(Значение);
		Результат.Контрагент = НайтиКонтрагентаПоТелефону(НормТелефон);
		Если Не ЗначениеЗаполнено(Результат.Контрагент) Тогда
			Результат.КартаLoyalCards = Справочники.LC_КартыLoyalCards.НайтиПоТелефону(НормТелефон);
			Если ЗначениеЗаполнено(Результат.КартаLoyalCards) Тогда
				Результат.Контрагент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Результат.КартаLoyalCards, "Владелец");
			КонецЕсли;
		Иначе
			Результат.КартаLoyalCards = Справочники.LC_КартыLoyalCards.НайтиПоКонтрагенту(Результат.Контрагент);
		КонецЕсли;
		
	ИначеЕсли СпособИдентификации = Перечисления.LC_СпособыИдентификацииКлиента.НомерКарты Тогда
		
		Результат.КартаLoyalCards = Справочники.LC_КартыLoyalCards.НайтиПоMemberId(Значение);
		Если ЗначениеЗаполнено(Результат.КартаLoyalCards) Тогда
			Результат.Контрагент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Результат.КартаLoyalCards, "Владелец");
		КонецЕсли;
		
	ИначеЕсли СпособИдентификации = Перечисления.LC_СпособыИдентификацииКлиента.SerialNumber
		Или СпособИдентификации = Перечисления.LC_СпособыИдентификацииКлиента.QRКод Тогда
		
		Результат.КартаLoyalCards = Справочники.LC_КартыLoyalCards.НайтиПоSerialNumber(Значение);
		Если ЗначениеЗаполнено(Результат.КартаLoyalCards) Тогда
			Результат.Контрагент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Результат.КартаLoyalCards, "Владелец");
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Результат.Контрагент) Тогда
		Результат.Баланс = LC_БонуснаяПрограммаСервер.ПолучитьБалансКлиента(Результат.Контрагент);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ИспользуетсяБонуснаяПрограмма(ДокументОбъект)
	Возврат ЗначениеЗаполнено(ДокументОбъект.LC_КонтрагентБонуснойПрограммы);
КонецФункции

Функция ПолучитьСуммуЧека(ДокументОбъект)
	// Адаптувати до реквізита суми чека в BAS Роздріб UA
	Возврат ДокументОбъект.СуммаДокумента;
КонецФункции

Функция ПолучитьЧекОснованиеВозврата(ДокументВозврат)
	// Адаптувати до реквізита зв'язку з чеком у документі повернення
	Возврат ДокументВозврат.ЧекККМ;
КонецФункции

Функция РассчитатьКоэффициентВозврата(ДокументВозврат, ЧекОснование)
	
	СуммаЧека = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЧекОснование, "СуммаДокумента");
	СуммаВозврата = ДокументВозврат.СуммаДокумента;
	
	Если СуммаЧека <= 0 Тогда
		Возврат 0;
	КонецЕсли;
	
	Возврат Мин(1, СуммаВозврата / СуммаЧека);
	
КонецФункции

Функция НайтиКонтрагентаПоТелефону(Телефон)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Контрагенты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.LC_ТелефонДляБонусов = &Телефон
	|	И НЕ Контрагенты.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Телефон", Телефон);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Справочники.Контрагенты.ПустаяСсылка();
	
КонецФункции

Функция НайтиКартуПоMemberId(MemberId)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Карты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.LC_КартыLoyalCards КАК Карты
	|ГДЕ
	|	Карты.MemberId = &MemberId
	|	И НЕ Карты.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("MemberId", MemberId);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Справочники.LC_КартыLoyalCards.ПустаяСсылка();
	
КонецФункции

Функция НайтиКартуПоSerialNumber(SerialNumber)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Карты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.LC_КартыLoyalCards КАК Карты
	|ГДЕ
	|	Карты.SerialNumber = &SerialNumber
	|	И НЕ Карты.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("SerialNumber", SerialNumber);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Справочники.LC_КартыLoyalCards.ПустаяСсылка();
	
КонецФункции

#КонецОбласти
