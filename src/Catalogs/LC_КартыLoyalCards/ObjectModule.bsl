////////////////////////////////////////////////////////////////////////////////
// Справочник LC_КартыLoyalCards — модуль об'єкта
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	// Нормалізація телефону
	Если ЗначениеЗаполнено(Телефон) Тогда
		Телефон = LC_ОбщегоНазначения.НормализоватьТелефон(Телефон);
	КонецЕсли;
	
	// Перевірка обов'язкових полів
	Если Не ЗначениеЗаполнено(Владелец) Тогда
		ВызватьИсключение "Не вказано власника (контрагента) картки Loyal Cards.";
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(SerialNumber) Тогда
		ВызватьИсключение "Не вказано Serial Number картки.";
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(MemberId) Тогда
		ВызватьИсключение "Не вказано номер картки (MemberId).";
	КонецЕсли;
	
	// Заповнення найменування, якщо порожнє
	Если Не ЗначениеЗаполнено(Наименование) Тогда
		Наименование = СтрШаблон("%1 — %2",
			ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Владелец, "Наименование"),
			MemberId);
	КонецЕсли;
	
	// Перевірка унікальності SerialNumber
	ПроверитьУникальность("SerialNumber", SerialNumber, Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	// Перевірка унікальності MemberId
	ПроверитьУникальность("MemberId", MemberId, Отказ);
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	// Оновити зворотне посилання в контрагенті (телефон для бонусів)
	Если ЗначениеЗаполнено(Телефон) И ЗначениеЗаполнено(Владелец) Тогда
		ТекущийТелефон = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Владелец, "LC_ТелефонДляБонусов");
		Если ТекущийТелефон <> Телефон Тогда
			КонтрагентОбъект = Владелец.ПолучитьОбъект();
			КонтрагентОбъект.LC_ТелефонДляБонусов = Телефон;
			КонтрагентОбъект.Записать();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьУникальность(ИмяРеквизита, Значение, Отказ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = СтрШаблон(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Карты.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.LC_КартыLoyalCards КАК Карты
		|ГДЕ
		|	Карты.%1 = &Значение
		|	И Карты.Ссылка <> &ТекущаяСсылка
		|	И НЕ Карты.ПометкаУдаления",
		ИмяРеквизита);
	
	Запрос.УстановитьПараметр("Значение", Значение);
	Запрос.УстановитьПараметр("ТекущаяСсылка", Ссылка);
	
	Если Не Запрос.Выполнить().Пустой() Тогда
		ВызватьИсключение СтрШаблон("Картка з %1 = ""%2"" вже існує.", ИмяРеквизита, Значение);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
