#Область ПрограммныйИнтерфейс

// Знаходить активну картку за контрагентом.
//
Функция НайтиПоКонтрагенту(Контрагент) Экспорт
	
	Если Не ЗначениеЗаполнено(Контрагент) Тогда
		Возврат ПустаяСсылка();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Карты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.LC_КартыLoyalCards КАК Карты
	|ГДЕ
	|	Карты.Владелец = &Контрагент
	|	И Карты.Статус = ЗНАЧЕНИЕ(Перечисление.LC_СтатусыКартыLoyalCards.Активна)
	|	И НЕ Карты.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Карты.ДатаВыпуска УБЫВ";
	
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат ПустаяСсылка();
	
КонецФункции

