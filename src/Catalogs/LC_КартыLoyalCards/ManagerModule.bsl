// Створює елемент довідника на основі відповіді Loyal Cards API.
//
// Параметри:
//  Контрагент    - СправочникСсылка.Контрагенты
//  ОтветAPI      - Структура - passTypeIdentifier, serialNumber, url
//  MemberId      - Рядок - номер картки
//  Уровень       - СправочникСсылка.LC_УровниЛояльности
//  Телефон       - Рядок - необов'язково
//
// Повертає:
//  СправочникСсылка.LC_КартыLoyalCards
//
Функция СоздатьИзОтветаAPI(Контрагент, ОтветAPI, MemberId, Уровень = Неопределено, Телефон = "") Экспорт
	
	КартаОбъект = СоздатьЭлемент();
	КартаОбъект.Владелец = Контрагент;
	КартаОбъект.Наименование = СтрШаблон("%1 — %2",
		ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Контрагент, "Наименование"),
		MemberId);
	КартаОбъект.SerialNumber = ОтветAPI.serialNumber;
	КартаОбъект.PassTypeIdentifier = ОтветAPI.passTypeIdentifier;
	КартаОбъект.MemberId = MemberId;
	КартаОбъект.URL = ОтветAPI.url;
	КартаОбъект.УровеньЛояльности = Уровень;
	КартаОбъект.Телефон = LC_ОбщегоНазначения.НормализоватьТелефон(Телефон);
	КартаОбъект.Статус = Перечисления.LC_СтатусыКартыLoyalCards.Активна;
	КартаОбъект.ДатаВыпуска = ТекущаяДатаСеанса();
	КартаОбъект.Записать();
	
	Возврат КартаОбъект.Ссылка;
	
КонецФункции

// Створює wallet-картку через API і записує елемент довідника.
//
Функция ВыпуститьКарту(Контрагент, Телефон = "", MemberId = "") Экспорт
	
	Если Не ЗначениеЗаполнено(Контрагент) Тогда
		ВызватьИсключение "Не вказано контрагента для випуску картки.";
	КонецЕсли;
	
	// Перевірка наявності активної картки
	СуществующаяКарта = НайтиПоКонтрагенту(Контрагент);
	Если ЗначениеЗаполнено(СуществующаяКарта) Тогда
		Возврат СуществующаяКарта;
	КонецЕсли;
	
	Уровень = LC_БонуснаяПрограммаСервер.ПолучитьУровеньЛояльностиКонтрагента(Контрагент);
	НаименованиеКонтрагента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Контрагент, "Наименование");
	
	Если Не ЗначениеЗаполнено(Телефон) Тогда
		Телефон = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Контрагент, "LC_ТелефонДляБонусов");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(MemberId) Тогда
		MemberId = СгенерироватьMemberId(Контрагент);
	КонецЕсли;
	
	Баланс = LC_БонуснаяПрограммаСервер.ПолучитьБалансКлиента(Контрагент);
	
	ДанныеКарты = Новый Структура;
	ДанныеКарты.Вставить("firstName", НаименованиеКонтрагента);
	ДанныеКарты.Вставить("tel", LC_ОбщегоНазначения.НормализоватьТелефон(Телефон));
	ДанныеКарты.Вставить("memberId", MemberId);
	ДанныеКарты.Вставить("balance", Формат(Баланс.Доступно, "ЧДЦ=2; ЧРГ=''; ЧГ=0"));
	
	ПроцентСкидки = 0;
	Если ЗначениеЗаполнено(Уровень) Тогда
		ПроцентСкидки = Уровень.ПроцентСкидки;
	КонецЕсли;
	ДанныеКарты.Вставить("discount", Формат(ПроцентСкидки, "ЧДЦ=0; ЧРГ=''; ЧГ=0"));
	
	ОтветAPI = LC_LoyalCardsAPI.СоздатьКарту(ДанныеКарты);
	Если ОтветAPI = Неопределено Тогда
		ВызватьИсключение "Не вдалося створити картку в Loyal Cards API.";
	КонецЕсли;
	
	Возврат СоздатьИзОтветаAPI(Контрагент, ОтветAPI, MemberId, Уровень, Телефон);
	
КонецФункции

// Деактивує картку в BAS і в API.
//
Процедура ДеактивироватьКарту(Карта) Экспорт
	
	Если Не ЗначениеЗаполнено(Карта) Тогда
		Возврат;
	КонецЕсли;
	
	SerialNumber = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Карта, "SerialNumber");
	LC_LoyalCardsAPI.ДеактивироватьКарту(SerialNumber);
	
	КартаОбъект = Карта.ПолучитьОбъект();
	КартаОбъект.Статус = Перечисления.LC_СтатусыКартыLoyalCards.Неактивна;
	КартаОбъект.Записать();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПустаяСсылка()
	Возврат Справочники.LC_КартыLoyalCards.ПустаяСсылка();
КонецФункции

Функция СгенерироватьMemberId(Контрагент)
	
	// Спробувати взяти код існуючої інформаційної картки
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Карты.КодКарты КАК КодКарты
	|ИЗ
	|	Справочник.ИнформационныеКарты КАК Карты
	|ГДЕ
	|	Карты.Владелец = &Контрагент
	|	И НЕ Карты.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.КодКарты) Тогда
		Возврат Выборка.КодКарты;
	КонецЕсли;
	
	Возврат Формат(Контрагент.Код, "ЧЦ=13; ЧВН=; ЧГ=0");
	
КонецФункции

#КонецОбласти
