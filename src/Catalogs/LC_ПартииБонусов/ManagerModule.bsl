#Область ПрограммныйИнтерфейс

// Створює нову партію бонусів.
//
Функция СоздатьПартию(Контрагент, ДокументОснование, СуммаНачислена) Экспорт
	
	ПартияОбъект = СоздатьЭлемент();
	ПартияОбъект.Код = LC_ОбщегоНазначения.НовыйИдентификатор();
	ПартияОбъект.Владелец = Контрагент;
	ПартияОбъект.ДокументОснование = ДокументОснование;
	ПартияОбъект.СуммаНачислена = СуммаНачислена;
	ПартияОбъект.Наименование = СтрШаблон("Партія %1 від %2",
		Формат(СуммаНачислена, "ЧДЦ=2"),
		Формат(ТекущаяДатаСеанса(), "ДЛФ=D"));
	ПартияОбъект.Записать();
	
	Возврат ПартияОбъект.Ссылка;
	
КонецФункции

#КонецОбласти
