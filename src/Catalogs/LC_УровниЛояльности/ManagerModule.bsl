////////////////////////////////////////////////////////////////////////////////
// Довідник LC_УровниЛояльности — модуль менеджера
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Повертає рівень «Стандарт» (5% / 20% / 14 днів / 4 міс.).
//
Функция ПолучитьСтандартный() Экспорт
	Возврат НайтиПоНаименованию("Стандарт");
КонецФункции

// Повертає рівень «VIP».
//
Функция ПолучитьVIP() Экспорт
	Возврат НайтиПоНаименованию("VIP");
КонецФункции

// Повертає рівень за відсотком знижки (для міграції 5%/10%).
//
Функция ПолучитьПоПроцентуСкидки(ПроцентСкидки) Экспорт
	
	Если ПроцентСкидки >= 10 Тогда
		Возврат ПолучитьVIP();
	КонецЕсли;
	
	Возврат ПолучитьСтандартный();
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НайтиПоНаименованию(Наименование)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Уровни.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.LC_УровниЛояльности КАК Уровни
	|ГДЕ
	|	Уровни.Наименование = &Наименование
	|	И НЕ Уровни.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Наименование", Наименование);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Справочники.LC_УровниЛояльности.ПустаяСсылка();
	
КонецФункции

#КонецОбласти
