////////////////////////////////////////////////////////////////////////////////
// Регістр накопичення LC_БонусныеБаллыКлиентов — модуль менеджера
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Залишок доступних бонусів контрагента.
//
Функция ПолучитьДоступныйОстаток(Контрагент, ДатаСреза = Неопределено) Экспорт
	Возврат ПолучитьОстатокПоСостоянию(Контрагент,
		Перечисления.LC_СостоянияБонусов.Доступны, ДатаСреза);
КонецФункции

// Залишок бонусів, що очікують активації.
//
Функция ПолучитьОжидающийОстаток(Контрагент, ДатаСреза = Неопределено) Экспорт
	Возврат ПолучитьОстатокПоСостоянию(Контрагент,
		Перечисления.LC_СостоянияБонусов.ОжидаетАктивации, ДатаСреза);
КонецФункции

// Залишки по партіях для FIFO-списання (тільки «Доступны»).
//
Функция ПолучитьОстаткиПоПартиямFIFO(Контрагент, ДатаСреза = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Остатки.ПартияБонусов КАК ПартияБонусов,
	|	Остатки.КоличествоОстаток КАК Количество,
	|	Партии.ДатаСгорания КАК ДатаСгорания
	|ИЗ
	|	РегистрНакопления.LC_БонусныеБаллыКлиентов.Остатки(
	|			&ДатаСреза,
	|			Контрагент = &Контрагент
	|				И СостояниеБонусов = ЗНАЧЕНИЕ(Перечисление.LC_СостоянияБонусов.Доступны)) КАК Остатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.LC_ПартииБонусов КАК Партии
	|		ПО Остатки.ПартияБонусов = Партии.ПартияБонусов
	|ГДЕ
	|	Остатки.КоличествоОстаток > 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаСгорания";
	
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("ДатаСреза", ?(ДатаСреза = Неопределено, Неопределено, ДатаСреза));
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьОстатокПоСостоянию(Контрагент, СостояниеБонусов, ДатаСреза)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Остатки.КоличествоОстаток), 0) КАК Количество
	|ИЗ
	|	РегистрНакопления.LC_БонусныеБаллыКлиентов.Остатки(
	|			&ДатаСреза,
	|			Контрагент = &Контрагент
	|				И СостояниеБонусов = &СостояниеБонусов) КАК Остатки";
	
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("СостояниеБонусов", СостояниеБонусов);
	Запрос.УстановитьПараметр("ДатаСреза", ?(ДатаСреза = Неопределено, Неопределено, ДатаСреза));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Количество;
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции

#КонецОбласти
