////////////////////////////////////////////////////////////////////////////////
// Обробка LC_МиграцияВБонуснуюПрограмму
// Перенесення існуючих клієнтів, дисконтних карт і знижок 5%/10%
// у нову бонусну програму з випуском wallet-карт.
////////////////////////////////////////////////////////////////////////////////

#Область ОписаниеПеременных

Перем ТаблицаРезультатов;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ВыполнитьМиграциюНаСервере(УровеньСтандарт, УровеньVIP, СоздаватьWalletКарты)
	
	ТаблицаРезультатов = Новый ТаблицаЗначений;
	ТаблицаРезультатов.Колонки.Добавить("Контрагент");
	ТаблицаРезультатов.Колонки.Добавить("Статус");
	ТаблицаРезультатов.Колонки.Добавить("Комментарий");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Контрагенты.Ссылка КАК Контрагент,
	|	Контрагенты.Наименование КАК Наименование,
	|	Контрагенты.НомерТелефона КАК Телефон
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	НЕ Контрагенты.ПометкаУдаления
	|	И Контрагенты.Покупатель = ИСТИНА
	|	И НЕ Контрагенты.LC_МигрированВБонуснуюПрограмму";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Попытка
			МигрироватьКонтрагента(Выборка, УровеньСтандарт, УровеньVIP, СоздаватьWalletКарты);
		Исключение
			ДобавитьРезультат(Выборка.Контрагент, "Помилка", ОписаниеОшибки());
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура МигрироватьКонтрагента(СтрокаКонтрагент, УровеньСтандарт, УровеньVIP, СоздаватьWalletКарты)
	
	КонтрагентОбъект = СтрокаКонтрагент.Контрагент.ПолучитьОбъект();
	
	// Визначення рівня за поточною знижкою
	ТекущаяСкидка = ПолучитьТекущуюСкидкуКонтрагента(СтрокаКонтрагент.Контрагент);
	
	Если ТекущаяСкидка >= 10 Тогда
		Уровень = УровеньVIP;
	Иначе
		Уровень = УровеньСтандарт;
	КонецЕсли;
	
	КонтрагентОбъект.LC_УровеньЛояльности = Уровень;
	КонтрагентОбъект.LC_ТелефонДляБонусов = LC_ОбщегоНазначения.НормализоватьТелефон(СтрокаКонтрагент.Телефон);
	КонтрагентОбъект.LC_МигрированВБонуснуюПрограмму = Истина;
	КонтрагентОбъект.Записать();
	
	// Створення wallet-картки
	Если СоздаватьWalletКарты И ЗначениеЗаполнено(КонтрагентОбъект.LC_ТелефонДляБонусов) Тогда
		
		MemberId = ПолучитьИлиСоздатьMemberId(СтрокаКонтрагент.Контрагент);
		
		ДанныеКарты = Новый Структура;
		ДанныеКарты.Вставить("firstName", СтрокаКонтрагент.Наименование);
		ДанныеКарты.Вставить("tel", КонтрагентОбъект.LC_ТелефонДляБонусов);
		ДанныеКарты.Вставить("memberId", MemberId);
		ДанныеКарты.Вставить("balance", "0");
		ДанныеКарты.Вставить("discount", Формат(Уровень.ПроцентСкидки, "ЧДЦ=0; ЧРГ=''; ЧГ=0"));
		
		ОтветAPI = LC_LoyalCardsAPI.СоздатьКарту(ДанныеКарты);
		
		Если ОтветAPI <> Неопределено Тогда
			СоздатьЗаписьКартыВБазе(СтрокаКонтрагент.Контрагент, ОтветAPI, MemberId, Уровень);
			ДобавитьРезультат(СтрокаКонтрагент.Контрагент, "OK", "Картку створено");
		Иначе
			ДобавитьРезультат(СтрокаКонтрагент.Контрагент, "Попередження", "Рівень призначено, картку не створено (API)");
		КонецЕсли;
		
	Иначе
		ДобавитьРезультат(СтрокаКонтрагент.Контрагент, "OK", "Рівень призначено без wallet-картки");
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьТекущуюСкидкуКонтрагента(Контрагент)
	
	// Адаптувати: читати з регістру УсловияПредоставленияСкидок або реквізита картки
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Условия.ПроцентСкидки КАК ПроцентСкидки
	|ИЗ
	|	РегистрСведений.УсловияПредоставленияСкидок.СрезПоследних(, Контрагент = &Контрагент) КАК Условия";
	
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ПроцентСкидки;
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции

Функция ПолучитьИлиСоздатьMemberId(Контрагент)
	
	// Використати номер інформаційної картки або згенерувати EAN-13
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Карты.КодКарты КАК КодКарты
	|ИЗ
	|	Справочник.ИнформационныеКарты КАК Карты
	|ГДЕ
	|	Карты.Владелец = &Контрагент
	|	И НЕ Карты.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.КодКарты) Тогда
		Возврат Выборка.КодКарты;
	КонецЕсли;
	
	Возврат Формат(Контрагент.Код, "ЧЦ=13; ЧВН=; ЧГ=0");
	
КонецФункции

Процедура СоздатьЗаписьКартыВБазе(Контрагент, ОтветAPI, MemberId, Уровень)
	
	КартаОбъект = Справочники.LC_КартыLoyalCards.СоздатьЭлемент();
	КартаОбъект.Владелец = Контрагент;
	КартаОбъект.SerialNumber = ОтветAPI.serialNumber;
	КартаОбъект.PassTypeIdentifier = ОтветAPI.passTypeIdentifier;
	КартаОбъект.MemberId = MemberId;
	КартаОбъект.URL = ОтветAPI.url;
	КартаОбъект.УровеньЛояльности = Уровень;
	КартаОбъект.Статус = Перечисления.LC_СтатусыКартыLoyalCards.Активна;
	КартаОбъект.ДатаВыпуска = ТекущаяДатаСеанса();
	КартаОбъект.Записать();
	
КонецПроцедуры

Процедура ДобавитьРезультат(Контрагент, Статус, Комментарий)
	
	НоваяСтрока = ТаблицаРезультатов.Добавить();
	НоваяСтрока.Контрагент = Контрагент;
	НоваяСтрока.Статус = Статус;
	НоваяСтрока.Комментарий = Комментарий;
	
КонецПроцедуры

#КонецОбласти
